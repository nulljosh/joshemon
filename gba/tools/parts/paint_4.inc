#define PADX 8
#define PADY 6
int main(int argc, char **argv) {
  const char *out = argc > 1 ? argv[1] : "build";
  make_tiles();
  char path[512]; snprintf(path, sizeof path, "%s/maps.c", out);
  FILE *f = fopen(path, "w"); if (!f) { perror(path); return 1; }
  // every map at frames 0 and 32 (water and flowers), cut and deduped across the game
  int nmaps = MAP_INFO_COUNT; typedef struct { int cw, ch, nlocal, *local, *ground, *over, nanim, (*anim)[3]; } Out; Out *o = calloc(nmaps, sizeof *o);
  for (int id = 0; id < nmaps; id++) {
    Cv g0, o0, g1, o1; export_map(id, 0, PADX, PADY, &g0, &o0); export_map(id, 32, PADX, PADY, &g1, &o1);
    int cw = g0.w / 8, ch = g0.h / 8, *local = malloc(sizeof(int) * (cw * ch * 2 + 8)), nl = 0, *ground = malloc(sizeof(int) * cw * ch), *over = malloc(sizeof(int) * cw * ch), (*anim)[3] = malloc(sizeof(int[3]) * cw * ch), na = 0;
    long keys[4096]; int kidx[4096], nk = 0; // the local tile slots, keyed by bank tile (or anim pair)
#define USE(KEY, VAL) ({ long _key = (KEY); int _k = -1; for (int _i = 0; _i < nk; _i++) if (keys[_i] == _key) { _k = kidx[_i]; break; } if (_k < 0) { _k = nl; local[nl++] = (VAL); keys[nk] = _key; kidx[nk++] = _k; } _k; })
    for (int ty = 0; ty < ch; ty++) for (int tx = 0; tx < cw; tx++) {
      int a = cut(&g0, tx, ty), b = cut(&g1, tx, ty);
      if (a != b) { long key = (1L << 40) | ((long)a << 20) | b; int before = nl; int k = USE(key, a); if (nl > before) { anim[na][0] = k; anim[na][1] = a; anim[na][2] = b; na++; } ground[ty * cw + tx] = k; }
      else ground[ty * cw + tx] = USE(a, a);
      int ov = cut(&o0, tx, ty), blank = 1; for (int i = 0; i < 64; i++) blank &= !bank[ov][i];
      over[ty * cw + tx] = blank ? -1 : USE(ov, ov);
    }
    o[id] = (Out){ cw, ch, nl, local, ground, over, na, anim };
    free(g0.p); free(o0.p); free(g1.p); free(o1.p);
  }
  // slot 0 of every map is reserved blank so an empty canopy cell can point at it
  unsigned char zero[64] = { 0 }; int blank = 0;
  for (int id = 0; id < nmaps; id++) {
    Out *m = &o[id];
    for (int i = 0; i < m->cw * m->ch; i++) { m->ground[i]++; m->over[i] = m->over[i] < 0 ? 0 : m->over[i] + 1; }
    for (int i = 0; i < m->nanim; i++) m->anim[i][0]++;
    blank = add_tile(zero);
    memmove(m->local + 1, m->local, sizeof(int) * m->nlocal); m->local[0] = blank; m->nlocal++;
  }
  int worst = 0; for (int id = 0; id < nmaps; id++) if (o[id].nlocal > worst) worst = o[id].nlocal;
  fprintf(stderr, "maps %d, shared tiles %d, palette %d, most tiles in one map %d\n", nmaps, nbank, npal, worst);
  fprintf(f, "// generated by gba/tools/paint.c: do not edit\n#include \"maps.h\"\n");
  fprintf(f, "const unsigned short MAP_PAL[%d] = {", npal); for (int i = 0; i < npal; i++) fprintf(f, "%s%d", i ? "," : "", pal[i]); fprintf(f, "};\n");
  fprintf(f, "const unsigned int TILE_BANK[%d] = {", nbank * 16);
  for (int i = 0; i < nbank; i++) for (int k = 0; k < 64; k += 4) fprintf(f, "%s0x%x", i || k ? "," : "", bank[i][k] | bank[i][k + 1] << 8 | bank[i][k + 2] << 16 | (unsigned)bank[i][k + 3] << 24);
  fprintf(f, "};\n");
  for (int id = 0; id < nmaps; id++) {
    Out *m = &o[id];
    fprintf(f, "static const unsigned short T%d[%d] = {", id, m->nlocal); for (int i = 0; i < m->nlocal; i++) fprintf(f, "%s%d", i ? "," : "", m->local[i]); fprintf(f, "};\n");
    fprintf(f, "static const unsigned short G%d[%d] = {", id, m->cw * m->ch); for (int i = 0; i < m->cw * m->ch; i++) fprintf(f, "%s%d", i ? "," : "", m->ground[i]); fprintf(f, "};\n");
    fprintf(f, "static const unsigned short O%d[%d] = {", id, m->cw * m->ch); for (int i = 0; i < m->cw * m->ch; i++) fprintf(f, "%s%d", i ? "," : "", m->over[i]); fprintf(f, "};\n");
    fprintf(f, "static const unsigned short A%d[%d] = {", id, m->nanim ? m->nanim * 3 : 1); if (!m->nanim) fprintf(f, "0"); for (int i = 0; i < m->nanim; i++) fprintf(f, "%s%d,%d,%d", i ? "," : "", m->anim[i][0], m->anim[i][1], m->anim[i][2]); fprintf(f, "};\n");
  }
  fprintf(f, "const MapGfx MAP_GFX[%d] = {\n", nmaps);
  for (int id = 0; id < nmaps; id++) fprintf(f, "  { %d, %d, %d, %d, T%d, G%d, O%d, A%d },\n", o[id].cw, o[id].ch, o[id].nlocal, o[id].nanim, id, id, id, id);
  fprintf(f, "};\n");
  // people and things: down, up, left (right is left flipped), two steps each, 16x32 with the tile top at row 16
  int nlooks = LOOK_DATA_COUNT + 9, nw = 0, p16[16];
  fprintf(f, "const unsigned int SPRITE_TILES[] = {");
  int *spal = malloc(sizeof(int) * 16 * nlooks);
  for (int l = 0; l < nlooks; l++) {
    Cv fr[6]; int k = 0;
    for (int d = 0; d < 3; d++) for (int st = 0; st < 2; st++) {
      fr[k] = cv(16, 32); t = &fr[k];
      if (l < LOOK_DATA_COUNT) { Cv pp = bake_person(&LOOK_DATA[l], d, st); draw(&fr[k], &pp, 0, 0, 16, 20, 0, 12); free(pp.p); }
      else draw_thing(l - LOOK_DATA_COUNT, 0, 16, d, st, st * 16);
      k++;
    }
    pack(fr, 6, 16, 32, f, &nw, p16); memcpy(spal + l * 16, p16, sizeof p16);
    for (int i = 0; i < 6; i++) free(fr[i].p);
  }
  fprintf(f, "};\nconst unsigned short SPRITE_PAL[%d] = {", nlooks * 16); for (int i = 0; i < nlooks * 16; i++) fprintf(f, "%s%d", i ? "," : "", spal[i]); fprintf(f, "};\n");
  // trainer portraits (one per look) and the player's back, 32x32 doubled to 64x64
  nw = 0; fprintf(f, "const unsigned int PORTRAIT_TILES[] = {");
  int *ppal = malloc(sizeof(int) * 16 * (LOOK_DATA_COUNT + 1));
  for (int l = 0; l <= LOOK_DATA_COUNT; l++) {
    Cv small = bake_portrait(&LOOK_DATA[l < LOOK_DATA_COUNT ? l : 0], l == LOOK_DATA_COUNT), big = cv(64, 64);
    if (l == LOOK_DATA_COUNT) { free(big.p); big = bake_back64(); }
    else { for (int y = 0; y < 64; y++) for (int x = 0; x < 64; x++) memcpy(big.p + (y * 64 + x) * 4, small.p + ((y / 2) * 32 + x / 2) * 4, 4); refine64(&big, &LOOK_DATA[l]); }
    pack(&big, 1, 64, 64, f, &nw, p16); memcpy(ppal + l * 16, p16, sizeof p16);
    free(small.p); free(big.p);
  }
  fprintf(f, "};\nconst unsigned short PORTRAIT_PAL[%d] = {", (LOOK_DATA_COUNT + 1) * 16); for (int i = 0; i < (LOOK_DATA_COUNT + 1) * 16; i++) fprintf(f, "%s%d", i ? "," : "", ppal[i]); fprintf(f, "};\n");
  fclose(f);
  snprintf(path, sizeof path, "%s/maps.h", out); f = fopen(path, "w"); if (!f) { perror(path); return 1; }
  fprintf(f, "// generated by gba/tools/paint.c from data/world.c: do not edit\n#pragma once\n"
    "typedef struct { unsigned short cw, ch, ntiles, nanim; const unsigned short *tiles, *ground, *over, *anim; } MapGfx;\n"
    "#define MAP_PADX %d\n#define MAP_PADY %d\n#define MAP_PAL_SIZE %d\n"
    "extern const unsigned short MAP_PAL[];\nextern const unsigned int TILE_BANK[];\nextern const MapGfx MAP_GFX[];\n"
    "extern const unsigned int SPRITE_TILES[]; // per look: 6 frames (down 0/1, up 0/1, left 0/1) of 8 tiles\nextern const unsigned short SPRITE_PAL[];\n"
    "extern const unsigned int PORTRAIT_TILES[]; // per look, then the player's back: 64 tiles\nextern const unsigned short PORTRAIT_PAL[];\n", PADX, PADY, npal);
  fclose(f);
  return 0;
}
